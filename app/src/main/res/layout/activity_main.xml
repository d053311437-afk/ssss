<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layoutDirection="rtl">
<TextView android:text="FontMaster" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/pageTitle" android:text="ספריית גופנים" android:textSize="17sp" android:textColor="@color/accent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/navFonts" android:text="גופנים" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"/><Button android:id="@+id/navWallpapers" android:text="טפטים" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"/><Button android:id="@+id/navSettings" android:text="הגדרות" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp"/></LinearLayout>
<LinearLayout android:id="@+id/fontsSection" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp">
<TextView android:id="@+id/preview" android:text="שלום! כך נראה הכתב שלי&#10;FontMaster 2026" android:textSize="26sp" android:gravity="center" android:padding="28dp" android:background="@drawable/panel_background" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<EditText android:id="@+id/previewInput" android:hint="כתוב טקסט לתצוגה מקדימה" android:singleLine="true" android:layout_width="match_parent" android:layout_height="56dp"/>
<TextView android:id="@+id/selectedFont" android:textStyle="bold" android:textColor="@color/accent" android:textSize="17sp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="גודל כתב" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/><TextView android:id="@+id/sizeValue" android:text="26 sp" android:textColor="@color/accent" android:layout_width="wrap_content" android:layout_height="wrap_content"/><SeekBar android:id="@+id/sizeSeek" android:max="42" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="גופנים מובנים" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:layout_marginBottom="10dp"/><LinearLayout android:id="@+id/fontList" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/openDisplaySettings" android:text="אפשרויות גופן ותצוגה של המכשיר" android:layout_width="match_parent" android:layout_height="56dp"/>
<TextView android:text="Android לא נותן לאפליקציה רגילה הרשאה כללית להחליף בכוח את גופן המערכת. הכפתור פותח את אפשרויות היצרן הזמינות." android:textColor="@color/text_secondary" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
<LinearLayout android:id="@+id/wallpapersSection" android:visibility="gone" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"><TextView android:text="טפטים אופליין" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="לחיצה על טפט מגדירה אותו במכשיר" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp"/><LinearLayout android:id="@+id/wallpaperGrid" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
<LinearLayout android:id="@+id/settingsSection" android:visibility="gone" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"><TextView android:text="התאמה אישית" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content"/><Switch android:id="@+id/darkSwitch" android:text="מצב כהה" android:textSize="18sp" android:textColor="@color/text_primary" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/><TextView android:text="פרטי המכשיר" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"/><TextView android:id="@+id/deviceInfo" android:textColor="@color/text_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="18dp"/><Button android:id="@+id/appSettings" android:text="הגדרות והרשאות האפליקציה" android:layout_width="match_parent" android:layout_height="56dp"/><Button android:id="@+id/reset" android:text="איפוס כל ההגדרות" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="10dp"/><TextView android:text="FontMaster • גרסה 2.0&#10;עברית מלאה • RTL • עבודה אופליין" android:gravity="center" android:textColor="@color/text_secondary" android:padding="24dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></LinearLayout>
</LinearLayout></ScrollView>